# Copy to .env to override defaults. Never commit .env.

# OrangeHRM demo site
BASE_URL=https://opensource-demo.orangehrmlive.com

# Admin / manager account (public demo credentials shown on the login page)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# Optional: an employee prepared manually (steps 1-5 of the scenario).
# Leave both empty and the framework creates a fresh employee, ESS login and
# leave entitlement automatically before the test, then deletes it afterwards.
EMPLOYEE_USERNAME=
EMPLOYEE_PASSWORD=
EMPLOYEE_FULL_NAME=

# Leave type to apply for (must be entitled to the employee)
LEAVE_TYPE=US - Vacation

# How many days ahead the leave should start (the next working day on/after this)
LEAVE_DAYS_AHEAD=14

# Log level: debug | info | warn | error
LOG_LEVEL=info
